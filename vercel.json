{
  "redirects": [
    {
      "source": "/(.*)",
      "has": [{ "type": "host", "value": "www.azach.ca" }],
      "destination": "https://azach.ca/$1",
      "permanent": true
    }
  ],
  "rewrites": [
    {
      "source": "/catalog",
      "destination": "https://oomypczpxxpechltrqmq.supabase.co/storage/v1/object/public/campaign-media/r2r/AZACH-R2R-Catalog.pdf"
    },
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ]
}
